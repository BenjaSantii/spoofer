#!/usr/bin/env bash

set -euo pipefail

ADB_BIN="${ADB_BIN:-adb}"
APP_ID="com.benjasanti.spoofer"
COMPONENT="$APP_ID/com.spoofer.command.CommandActivity"
ADB_ARGS=()

if [[ -n "${ADB_SERIAL:-}" ]]; then
  ADB_ARGS=(-s "$ADB_SERIAL")
fi

usage() {
  printf '%s\n' \
    "Usage:" \
    "  tools/spoofer set-location <latitude> <longitude>" \
    "  tools/spoofer route <from-lat> <from-lng> <to-lat> <to-lng> --speed-kmh <km/h>" \
    "  tools/spoofer route <from-lat> <from-lng> <to-lat> <to-lng> --duration <seconds|Nm|Nh>" \
    "  tools/spoofer stop" \
    "  tools/spoofer status" \
    "" \
    "Set ADB_SERIAL when more than one device is connected."
}

run_command() {
  local action="$1"
  shift
  "$ADB_BIN" "${ADB_ARGS[@]}" shell am start -W \
    -n "$COMPONENT" \
    -a "$action" \
    "$@"
}

duration_seconds() {
  local value="$1"
  if [[ ! "$value" =~ ^[1-9][0-9]*[hms]?$ ]]; then
    printf 'Invalid duration: %s\n' "$value" >&2
    exit 2
  fi
  case "$value" in
    *h) printf '%s\n' "$(( ${value%h} * 3600 ))" ;;
    *m) printf '%s\n' "$(( ${value%m} * 60 ))" ;;
    *s) printf '%s\n' "${value%s}" ;;
    *) printf '%s\n' "$value" ;;
  esac
}

command="${1:-}"
case "$command" in
  set-location)
    [[ $# -eq 3 ]] || { usage; exit 2; }
    run_command "com.benjasanti.spoofer.command.SET_LOCATION" \
      --es latitude "$2" \
      --es longitude "$3"
    ;;
  route)
    [[ $# -eq 7 ]] || { usage; exit 2; }
    pacing_flag="$6"
    pacing_value="$7"
    pacing_args=()
    case "$pacing_flag" in
      --speed-kmh)
        pacing_args=(--es speed_kmh "$pacing_value")
        ;;
      --duration)
        pacing_args=(--es duration_seconds "$(duration_seconds "$pacing_value")")
        ;;
      *)
        usage
        exit 2
        ;;
    esac
    run_command "com.benjasanti.spoofer.command.START_ROUTE" \
      --es latitude "$2" \
      --es longitude "$3" \
      --es destination_latitude "$4" \
      --es destination_longitude "$5" \
      "${pacing_args[@]}"
    ;;
  stop)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    run_command "com.benjasanti.spoofer.command.STOP"
    ;;
  status)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    if "$ADB_BIN" "${ADB_ARGS[@]}" shell dumpsys activity services "$APP_ID" |
      grep -q "com.spoofer.service.MockLocationService"; then
      printf '%s\n' "active"
    else
      printf '%s\n' "inactive"
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac
